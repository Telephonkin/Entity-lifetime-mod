// This config file represents mechanics that will be used
{
  // What does the mod should log:
  // "spawn": log a game time, when an entity with a specific type and UUID got spawned
  // "despawn": log a game time, when an entity with a specific type and UUID got despawned
  "logs": [
    "spawn",
    "despawn"
  ],
  // Can mod despawn tagged entity
  "tagged_entities_can_despawn": false,

  // Can items live forever
  "items_live_forever": false

}